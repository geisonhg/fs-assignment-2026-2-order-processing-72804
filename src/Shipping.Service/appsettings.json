{
  "RabbitMQ": { "Host": "rabbitmq", "Port": "5672", "Username": "guest", "Password": "guest" },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning" } },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/shipping-.log", "rollingInterval": "Day" } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": { "ServiceName": "Shipping.Service" }
  }
}
