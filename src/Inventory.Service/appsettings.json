{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=SportsStore;User Id=sa;Password=YourStrong!Password123;TrustServerCertificate=True"
  },
  "RabbitMQ": { "Host": "rabbitmq", "Port": "5672", "Username": "guest", "Password": "guest" },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning" } },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/inventory-.log", "rollingInterval": "Day" } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": { "ServiceName": "Inventory.Service" }
  }
}
