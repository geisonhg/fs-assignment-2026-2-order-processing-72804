@inherits LayoutComponentBase
@inject CartService Cart
@inject NavigationManager Nav

<nav class="navbar ss-navbar px-3 mb-0">
    <a class="navbar-brand" href="/">&#127936; SportsStore</a>
    <div class="d-flex gap-1 align-items-center">
        <a class="nav-link @(Nav.Uri.Contains("/catalog") || new Uri(Nav.Uri).AbsolutePath == "/" ? "active" : "")" href="/catalog">Catalog</a>
        <a class="nav-link @(Nav.Uri.Contains("/cart") ? "active" : "")" href="/cart">
            Cart
            @if (Cart.TotalItems > 0)
            {
                <span class="badge ms-1" style="background:var(--brand-primary);">@Cart.TotalItems</span>
            }
        </a>
        <a class="nav-link @(Nav.Uri.Contains("/orders") && !Nav.Uri.Contains("/order-status") ? "active" : "")" href="/orders">My Orders</a>
        <a class="nav-link @(Nav.Uri.Contains("/order-status") ? "active" : "")" href="/order-status">Track Order</a>
    </div>
</nav>

<main class="container">
    @Body
</main>
