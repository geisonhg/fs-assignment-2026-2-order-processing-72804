@page "/checkout"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ApiService Api
@inject CartService Cart
@inject NavigationManager Nav

<PageTitle>Checkout</PageTitle>
<h1 class="mb-4">Checkout</h1>

@if (!Cart.Items.Any())
{
    <div class="alert alert-warning">Your cart is empty. <a href="/catalog">Add items first.</a></div>
    return;
}

@if (_submitting)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3">Placing your order&#8230;</p>
    </div>
    return;
}

@if (_error is not null)
{
    <div class="alert alert-danger">
        @_error
        <button class="btn btn-sm btn-link" @onclick="() => _error = null">Try again</button>
    </div>
}

<div class="row">
    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header">Shipping Details</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Customer ID</label>
                    <input class="form-control" type="number" min="1" @bind="_customerId" />
                    <div class="form-text">Don&#39;t have an ID? Use 1 (demo customer).</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input class="form-control" @bind="_shippingName" placeholder="John Doe" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Address Line 1</label>
                    <input class="form-control" @bind="_shippingLine1" placeholder="123 Main St" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Address Line 2 (optional)</label>
                    <input class="form-control" @bind="_shippingLine2" placeholder="Apt 4B" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">City</label>
                        <input class="form-control" @bind="_shippingCity" placeholder="New York" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Country</label>
                        <input class="form-control" @bind="_shippingCountry" placeholder="US" />
                    </div>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="giftWrap" @bind="_giftWrap" />
                    <label class="form-check-label" for="giftWrap">Gift wrap</label>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-header">Order Summary</div>
            <ul class="list-group list-group-flush">
                @foreach (var item in Cart.Items)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@item.ProductName &#215; @item.Quantity</span>
                        <span>@((item.UnitPrice * item.Quantity).ToString("C"))</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between fw-bold">
                    <span>Total</span>
                    <span>@Cart.Total.ToString("C")</span>
                </li>
            </ul>
            <div class="card-footer">
                <button class="btn btn-success w-100"
                        @onclick="PlaceOrderAsync"
                        disabled="@(!CanSubmit)">
                    Place Order
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    int _customerId = 1;
    string _shippingName = "";
    string _shippingLine1 = "";
    string? _shippingLine2;
    string _shippingCity = "";
    string _shippingCountry = "US";
    bool _giftWrap;
    bool _submitting;
    string? _error;

    bool CanSubmit => _customerId > 0
        && !string.IsNullOrWhiteSpace(_shippingName)
        && !string.IsNullOrWhiteSpace(_shippingLine1)
        && !string.IsNullOrWhiteSpace(_shippingCity)
        && !string.IsNullOrWhiteSpace(_shippingCountry);

    async Task PlaceOrderAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            var request = new CheckoutRequestDto
            {
                CustomerId = _customerId,
                Items = Cart.Items.Select(i => new CartItemDto
                {
                    ProductId = i.ProductId,
                    ProductName = i.ProductName,
                    UnitPrice = i.UnitPrice,
                    Quantity = i.Quantity
                }).ToList(),
                ShippingName = _shippingName,
                ShippingLine1 = _shippingLine1,
                ShippingLine2 = string.IsNullOrWhiteSpace(_shippingLine2) ? null : _shippingLine2,
                ShippingCity = _shippingCity,
                ShippingCountry = _shippingCountry,
                GiftWrap = _giftWrap
            };

            var order = await Api.CheckoutAsync(request);
            Cart.Clear();
            Nav.NavigateTo($"/order-status/{order.OrderId}");
        }
        catch (Exception ex)
        {
            _error = $"Order failed: {ex.Message}";
            _submitting = false;
        }
    }
}
