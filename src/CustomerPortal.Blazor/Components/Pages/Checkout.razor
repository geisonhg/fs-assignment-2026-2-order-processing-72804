@page "/checkout"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ApiService Api
@inject CartService Cart
@inject NavigationManager Nav

<PageTitle>Checkout – SportsStore</PageTitle>

<div class="page-header">
    <h1 class="mb-0">Checkout</h1>
</div>

@if (!Cart.Items.Any())
{
    <div class="alert alert-warning">Your cart is empty. <a href="/catalog">Add items first.</a></div>
    return;
}

@if (_submitting)
{
    <div class="loading-wrap">
        <div class="spinner-border text-primary" role="status"></div>
        <span>Placing your order…</span>
    </div>
    return;
}

@if (_error is not null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2">
        <span>&#9888;</span>
        <span>@_error</span>
        <button class="btn btn-sm btn-link ms-auto p-0" @onclick="() => _error = null">Try again</button>
    </div>
}

<div class="row g-4">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">&#128230; Shipping Details</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Customer ID</label>
                    <input class="form-control" type="number" min="1" @bind="_customerId" />
                    <div class="form-text text-muted">No account? Use ID <strong>1</strong> (demo customer).</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input class="form-control" @bind="_shippingName" placeholder="e.g. Jane Smith" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Address Line 1</label>
                    <input class="form-control" @bind="_shippingLine1" placeholder="e.g. 12 High Street" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Address Line 2 <span class="text-muted fw-normal">(optional)</span></label>
                    <input class="form-control" @bind="_shippingLine2" placeholder="Apartment, suite, etc." />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">City</label>
                        <input class="form-control" @bind="_shippingCity" placeholder="e.g. Dublin" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Country</label>
                        <input class="form-control" @bind="_shippingCountry" placeholder="e.g. Ireland" />
                    </div>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="giftWrap" @bind="_giftWrap" />
                    <label class="form-check-label fw-normal" for="giftWrap">&#127873; Add gift wrapping</label>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-header">&#128179; Order Summary</div>
            <ul class="list-group list-group-flush">
                @foreach (var item in Cart.Items)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3" style="border-color:#f0f2f8;">
                        <div>
                            <span class="fw-600">@item.ProductName</span>
                            <small class="text-muted d-block">x@item.Quantity</small>
                        </div>
                        <span class="fw-bold">@Eur(item.UnitPrice * item.Quantity)</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between align-items-center py-3" style="background:#f8f9fb;">
                    <span class="fw-bold" style="font-size:1rem;">Total</span>
                    <span class="fw-bold" style="font-size:1.15rem;color:var(--brand-primary);">@Eur(Cart.Total)</span>
                </li>
            </ul>
            <div class="card-footer">
                <button class="btn btn-success w-100 fw-bold py-2"
                        @onclick="PlaceOrderAsync"
                        disabled="@(!CanSubmit)">
                    &#9989; Place Order
                </button>
                @if (!CanSubmit)
                {
                    <p class="text-muted text-center mb-0 mt-2" style="font-size:.78rem;">Complete all required fields above.</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    int _customerId = 1;
    string _shippingName = "";
    string _shippingLine1 = "";
    string? _shippingLine2;
    string _shippingCity = "";
    string _shippingCountry = "Ireland";
    bool _giftWrap;
    bool _submitting;
    string? _error;

    static string Eur(decimal amount) => $"€{amount:N2}";

    bool CanSubmit => _customerId > 0
        && !string.IsNullOrWhiteSpace(_shippingName)
        && !string.IsNullOrWhiteSpace(_shippingLine1)
        && !string.IsNullOrWhiteSpace(_shippingCity)
        && !string.IsNullOrWhiteSpace(_shippingCountry);

    async Task PlaceOrderAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            var request = new CheckoutRequestDto
            {
                CustomerId = _customerId,
                Items = Cart.Items.Select(i => new CartItemDto
                {
                    ProductId = i.ProductId,
                    ProductName = i.ProductName,
                    UnitPrice = i.UnitPrice,
                    Quantity = i.Quantity
                }).ToList(),
                ShippingName = _shippingName,
                ShippingLine1 = _shippingLine1,
                ShippingLine2 = string.IsNullOrWhiteSpace(_shippingLine2) ? null : _shippingLine2,
                ShippingCity = _shippingCity,
                ShippingCountry = _shippingCountry,
                GiftWrap = _giftWrap
            };

            var order = await Api.CheckoutAsync(request);
            Cart.Clear();
            Nav.NavigateTo($"/order-status/{order.OrderId}");
        }
        catch (Exception ex)
        {
            _error = $"Order failed: {ex.Message}";
            _submitting = false;
        }
    }
}
