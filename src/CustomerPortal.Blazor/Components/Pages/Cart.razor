@page "/cart"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject CartService CartSvc
@inject NavigationManager Nav

<PageTitle>Your Cart – SportsStore</PageTitle>

<div class="page-header">
    <h1 class="mb-0">Your Cart</h1>
</div>

@if (!CartSvc.Items.Any())
{
    <div class="empty-state">
        <div style="font-size:3rem;margin-bottom:.75rem;">&#128722;</div>
        <p>Your cart is empty.</p>
        <a href="/catalog" class="btn btn-primary">Browse Products</a>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in CartSvc.Items)
            {
                <tr>
                    <td class="fw-600">@item.ProductName</td>
                    <td class="text-muted">@Eur(item.UnitPrice)</td>
                    <td>
                        <div class="qty-control">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => CartSvc.Decrement(item.ProductId)">&#8722;</button>
                            <span>@item.Quantity</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => CartSvc.Increment(item.ProductId)">+</button>
                        </div>
                    </td>
                    <td class="fw-bold">@Eur(item.UnitPrice * item.Quantity)</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => CartSvc.Remove(item.ProductId)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="fw-bold text-end" style="font-size:1rem;">Order Total</td>
                <td class="fw-bold" style="font-size:1.1rem;color:var(--brand-primary);">@Eur(CartSvc.Total)</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex gap-2 mt-3">
        <a href="/catalog" class="btn btn-outline-secondary">&#8592; Continue Shopping</a>
        <a href="/checkout" class="btn btn-primary ms-auto">Proceed to Checkout &#8594;</a>
        <button class="btn btn-outline-danger" @onclick="CartSvc.Clear">Clear Cart</button>
    </div>
}

@code {
    static string Eur(decimal amount) => $"€{amount:N2}";
}
