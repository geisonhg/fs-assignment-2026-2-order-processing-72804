@page "/catalog"
@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ApiService Api
@inject CartService Cart

<PageTitle>Product Catalog – SportsStore</PageTitle>

<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h1 class="mb-0">Product Catalog</h1>
        <p class="text-muted mb-0 mt-1" style="font-size:.9rem;">Browse and add items to your cart</p>
    </div>
</div>

@if (_loading)
{
    <div class="loading-wrap">
        <div class="spinner-border text-primary" role="status"></div>
        <span>Loading products…</span>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <div class="row mb-4 align-items-center">
        <div class="col-md-5 search-bar">
            <input class="form-control" placeholder="&#128269; Search products…" @bind="_search" @bind:event="oninput" @onkeyup="ApplyFilter" />
        </div>
        @if (!string.IsNullOrWhiteSpace(_search))
        {
            <div class="col-auto">
                <span class="text-muted small">@_filtered.Count result@(_filtered.Count == 1 ? "" : "s")</span>
            </div>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var p in _filtered)
        {
            <div class="col">
                <div class="card product-card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge rounded-pill" style="background:var(--brand-light);color:var(--brand-primary);font-size:.7rem;">@p.Category</span>
                            <span class="badge rounded-pill @(p.StockQuantity > 0 ? "bg-success" : "bg-secondary")">
                                @(p.StockQuantity > 0 ? $"{p.StockQuantity} in stock" : "Out of stock")
                            </span>
                        </div>
                        <h5 class="card-title mb-1">@p.Name</h5>
                        <p class="card-text text-muted small mb-3">@p.Description</p>
                        <p class="product-price mb-0">@Eur(p.Price)</p>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-primary btn-sm w-100"
                                disabled="@(p.StockQuantity == 0)"
                                @onclick="() => AddToCart(p)">
                            @(p.StockQuantity == 0 ? "Out of Stock" : "Add to Cart")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (_filtered.Count == 0)
    {
        <div class="empty-state">
            <p>&#128269; No products match "<strong>@_search</strong>"</p>
            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSearch">Clear search</button>
        </div>
    }
}

@if (_added is not null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast show align-items-center text-bg-success border-0">
            <div class="d-flex">
                <div class="toast-body">&#10003; <strong>@_added</strong> added to cart</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => _added = null"></button>
            </div>
        </div>
    </div>
}

@code {
    bool _loading = true;
    string? _error;
    string _search = "";
    string? _added;

    List<ProductDto> _products = [];
    List<ProductDto> _filtered = [];

    static string Eur(decimal amount) => $"€{amount:N2}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = await Api.GetProductsAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load products: {ex.Message}";
        }
        finally { _loading = false; }
    }

    void ClearSearch() { _search = ""; ApplyFilter(); }

    void ApplyFilter()
    {
        _filtered = string.IsNullOrWhiteSpace(_search)
            ? _products
            : _products.Where(p => p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                               || p.Category.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    async void AddToCart(ProductDto p)
    {
        Cart.Add(p.ProductId, p.Name, p.Price);
        _added = p.Name;
        StateHasChanged();
        await Task.Delay(2500);
        _added = null;
        StateHasChanged();
    }
}
