@page "/order-status"
@page "/order-status/{OrderId:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject ApiService Api

<PageTitle>Track Order – SportsStore</PageTitle>

<div class="page-header">
    <h1 class="mb-0">Track Your Order</h1>
    <p class="text-muted mb-0 mt-1" style="font-size:.9rem;">Enter your Order ID to see live status updates</p>
</div>

<div class="row mb-4">
    <div class="col-md-5">
        <label class="form-label">Order ID</label>
        <div class="input-group">
            <input class="form-control" type="number" min="1" @bind="_searchId" placeholder="e.g. 1" />
            <button class="btn btn-primary fw-600" @onclick="LoadOrderAsync">Track</button>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="loading-wrap">
        <div class="spinner-border text-primary" role="status"></div>
        <span>Loading order…</span>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger">&#9888; @_error</div>
}
else if (_order is not null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <span class="fw-bold" style="font-size:1rem;">Order #@_order.OrderId</span>
                <code class="ms-2 text-muted" style="font-size:.8rem;">@_order.OrderReference</code>
            </div>
            <span class="badge fs-6 @StatusBadge(_order.StatusDisplay)">@_order.StatusDisplay</span>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <div class="p-3 rounded" style="background:#f8f9fb;">
                        <div class="text-muted" style="font-size:.75rem;text-transform:uppercase;font-weight:700;letter-spacing:.06em;">Placed</div>
                        <div class="fw-600 mt-1">@_order.CreatedAt.ToString("d MMM yyyy, HH:mm")</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded" style="background:#f8f9fb;">
                        <div class="text-muted" style="font-size:.75rem;text-transform:uppercase;font-weight:700;letter-spacing:.06em;">Customer</div>
                        <div class="fw-600 mt-1">@_order.CustomerName</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded" style="background:#f8f9fb;">
                        <div class="text-muted" style="font-size:.75rem;text-transform:uppercase;font-weight:700;letter-spacing:.06em;">Shipping To</div>
                        <div class="fw-600 mt-1">@_order.ShippingLine1, @_order.ShippingCity, @_order.ShippingCountry</div>
                    </div>
                </div>
                @if (_order.ShipmentResult?.TrackingReference is not null)
                {
                    <div class="col-sm-6">
                        <div class="p-3 rounded" style="background:#f8f9fb;">
                            <div class="text-muted" style="font-size:.75rem;text-transform:uppercase;font-weight:700;letter-spacing:.06em;">Tracking Reference</div>
                            <code class="mt-1 d-block">@_order.ShipmentResult.TrackingReference</code>
                        </div>
                    </div>
                }
            </div>

            @if (_order.InventoryResult is { Success: false } || _order.PaymentResult is { Success: false })
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                    <span>&#10060;</span>
                    <span>
                        @if (_order.InventoryResult is { Success: false })
                        { <span>@_order.InventoryResult.FailureReason</span> }
                        @if (_order.PaymentResult is { Success: false })
                        { <span>@_order.PaymentResult.FailureReason</span> }
                    </span>
                </div>
            }

            <h6 class="fw-bold mb-3" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;color:#4a4e69;">Order Items</h6>
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in _order.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@Eur(item.UnitPrice)</td>
                            <td>@Eur(item.Subtotal)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="fw-bold text-end">Total</td>
                        <td class="fw-bold" style="color:var(--brand-primary);">@Eur(_order.TotalAmount)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @if (!IsTerminal(_order.StatusDisplay))
        {
            <div class="card-footer d-flex align-items-center gap-2 text-muted small">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span>Auto-refreshing every 5 seconds…</span>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int OrderId { get; set; }

    int _searchId;
    bool _loading;
    string? _error;
    OrderDto? _order;
    System.Threading.Timer? _timer;

    private static readonly HashSet<string> TerminalStatuses = ["Completed", "Failed", "Cancelled"];

    static bool IsTerminal(string s) => TerminalStatuses.Contains(s);

    static string Eur(decimal amount) => $"€{amount:N2}";

    protected override async Task OnParametersSetAsync()
    {
        if (OrderId > 0)
        {
            _searchId = OrderId;
            await LoadOrderAsync();
        }
    }

    async Task LoadOrderAsync()
    {
        if (_searchId <= 0) return;
        _loading = true;
        _error = null;
        _timer?.Dispose();
        _timer = null;
        try
        {
            _order = await Api.GetOrderAsync(_searchId);
            if (_order is not null && !IsTerminal(_order.StatusDisplay))
                _timer = new System.Threading.Timer(_ => InvokeAsync(RefreshAsync), null, 5000, 5000);
        }
        catch (Exception ex) { _error = $"Order not found: {ex.Message}"; }
        finally { _loading = false; }
    }

    async Task RefreshAsync()
    {
        if (_searchId <= 0) return;
        try
        {
            _order = await Api.GetOrderAsync(_searchId);
            if (_order is not null && IsTerminal(_order.StatusDisplay))
            {
                _timer?.Dispose();
                _timer = null;
            }
        }
        catch { /* silent refresh */ }
        StateHasChanged();
    }

    static string StatusBadge(string status) => status switch
    {
        "Pending" or "Submitted"               => "bg-secondary",
        "InventoryPending" or "PaymentPending"
            or "PaymentApproved" or "ShippingPending"
            or "ShippingCreated"               => "bg-warning text-dark",
        "InventoryConfirmed" or "Completed"    => "bg-success",
        "Failed" or "Cancelled"                => "bg-danger",
        _                                      => "bg-secondary"
    };

    public void Dispose() => _timer?.Dispose();
}
